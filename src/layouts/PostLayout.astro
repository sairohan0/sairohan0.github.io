---
import BaseLayout from './BaseLayout.astro';
import { SECTIONS } from '../consts';
import type { Post } from '../lib/posts';

interface Props {
	post: Post;
}
const { post } = Astro.props;
const { title, description, date, updated, tags } = post.data;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description}>
	<article>
		<p class="meta"><a href={`/${post.section}/`}>{SECTIONS[post.section].label}</a> · {fmt(date)}{updated && ` · updated ${fmt(updated)}`}</p>
		<h1>{title}</h1>
		{tags.length > 0 && (
			<ul class="tags">
				{tags.map((t) => <li><a class="tag" href={`/tags/${t}/`}>#{t}</a></li>)}
			</ul>
		)}
		<div class="prose">
			<slot />
		</div>
	</article>
</BaseLayout>
