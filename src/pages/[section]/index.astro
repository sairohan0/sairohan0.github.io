---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SECTIONS, SECTION_KEYS } from '../../consts';
import { getSectionPosts } from '../../lib/posts';

export function getStaticPaths() {
	return SECTION_KEYS.map((section) => ({ params: { section } }));
}

const { section } = Astro.params;
const { label, blurb } = SECTIONS[section as keyof typeof SECTIONS];
const posts = await getSectionPosts(section as keyof typeof SECTIONS);
---

<BaseLayout title={label} description={blurb}>
	<h1>{label}</h1>
	<p>{blurb}</p>
	{posts.length === 0 ? <p>Nothing here yet.</p> : posts.map((post) => <PostCard post={post} />)}
</BaseLayout>
